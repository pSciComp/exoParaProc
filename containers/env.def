Bootstrap: docker
From: ubuntu:24.04

%environment
    export LC_ALL=C
    export DEBIAN_FRONTEND=noninteractive

%post
    # 1. System Dependency Resolution
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        wget \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        gdal-bin \
        libgdal-dev \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # 2. Virtual Environment Initialization
    # PEP 668 compliance requires an isolated virtual environment
    python3 -m venv /opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # 3. Python Dependency Compilation
    pip install --no-cache-dir --upgrade pip
    
    # 4. Pipeline Application Dependencies
    # The GDAL Python package is omitted. rasterio is utilized for all I/O.
    pip install --no-cache-dir \
        rasterio \
        numpy \
        pystac-client

%runscript
    # The virtual environment Python interpreter is explicitly invoked
    exec /opt/venv/bin/python "$@"

%labels
    Author Parallel Pipeline Architecture
    Version 1.0.0
    Description Native multiprocessing environment relying exclusively on rasterio.
