Bootstrap: docker
From: ubuntu:24.04

%environment
    export LC_ALL=C
    export DEBIAN_FRONTEND=noninteractive
    # MPI execution parameters to suppress container-specific warnings
    export OMPI_MCA_btl_vader_single_copy_mechanism=none

%files
    # The project repository is copied into the container build context.
    # Execution of the build command from the repository root is required.
    . /opt/exopp

%post
    # 1. System Dependency Resolution
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        wget \
        git \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        libopenmpi-dev \
        openmpi-bin \
        gdal-bin \
        libgdal-dev \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # 2. Virtual Environment Initialization
    python3 -m venv /opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # 3. Python Dependency Compilation
    pip install --no-cache-dir --upgrade pip
    
    # 4. Package Installation via Dependency Group
    # The application is installed utilizing the optional [mpi] specification.
    # This automatically resolves mpi4py, rasterio, and base dependencies.
    cd /opt/exopp
    pip install --no-cache-dir .[mpi]

%runscript
    # The virtual environment Python interpreter is explicitly invoked
    exec /opt/venv/bin/python "$@"

%labels
    Author Parallel Pipeline Architecture
    Version 1.0.4
    Description MPI distributed environment utilizing optional dependency groups.
